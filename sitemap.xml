---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_pages = site.pages | where_exp: "item", "item.sitemap != false" %}
  {% for item in sitemap_pages %}
    {% if item.path contains '.md' or item.path contains '.html' %}
      {% if item.url and item.url != '/404.html' %}
  <url>
    <loc>{{ item.url | replace: 'index.html', '' | absolute_url | xml_escape }}</loc>
  </url>
      {% endif %}
    {% endif %}
  {% endfor %}
</urlset>
